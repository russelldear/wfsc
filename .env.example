# Copy to .env.local for local development. These values are public by
# design: they end up in the built site. Access control is enforced by
# row level security in the database, not by keeping these secret.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Optional banner text, e.g. "Staging"
VITE_ENV_LABEL=
